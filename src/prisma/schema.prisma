generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String         @id @default(uuid())
  name           String         @unique @db.VarChar(100)
  exchangeRate   Decimal        @db.Decimal(10, 4)
  timezone       String
  createdAt      DateTime       @default(now())
  slug           String         @unique @db.VarChar(60)
  orders         DiningOrder[]
  tables         DiningTable[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  submissions    Submission[]
  tableSessions  TableSession[]
  users          User[]
}

model User {
  id                     String    @id @default(uuid())
  businessId             String
  name                   String
  email                  String    @unique @db.VarChar(254)
  passwordHash           String
  role                   UserRole
  isActive               Boolean   @default(true)
  isVerified             Boolean   @default(false)
  createdAt              DateTime  @default(now())
  lastLogin              DateTime?
  refreshToken           String?
  refreshTokenExpiresAt  DateTime?
  resetPasswordExpiresAt DateTime?
  resetPasswordToken     String?
  payments               Payment[]
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@index([refreshTokenExpiresAt])
  @@index([resetPasswordExpiresAt])
}

model MenuCategory {
  id         String     @id @default(uuid())
  businessId String
  name       String     @db.VarChar(50)
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model MenuItem {
  id         String       @id @default(uuid())
  businessId String
  categoryId String
  name       String       @db.VarChar(100)
  priceUSD   Decimal      @db.Decimal(10, 2)
  priceLBP   Decimal      @db.Decimal(12, 2)
  soldOut    Boolean      @default(false)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderLines OrderLine[]

  @@index([businessId])
  @@index([categoryId])
  @@index([businessId, soldOut])
}

model DiningTable {
  id         String         @id @default(uuid())
  businessId String
  label      String         @db.VarChar(50)
  qrToken    String         @unique @db.Char(64)
  isDisabled Boolean        @default(false)
  createdAt  DateTime       @default(now())
  slug       String         @db.VarChar(60)
  orders     DiningOrder[]
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions   TableSession[]

  @@unique([businessId, label])
  @@unique([businessId, slug])
  @@index([businessId])
}

model TableSession {
  id            String             @id @default(uuid())
  businessId    String
  tableId       String
  status        TableSessionStatus @default(OPEN)
  activeTableId String?            @unique
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  totalUSD      Decimal            @default(0) @db.Decimal(12, 2)
  totalLBP      Decimal            @default(0) @db.Decimal(14, 2)
  amountPaidUSD Decimal            @default(0) @db.Decimal(12, 2)
  amountPaidLBP Decimal            @default(0) @db.Decimal(14, 2)
  orders        DiningOrder[]
  guestSessions GuestSession[]
  payments      Payment[]
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table         DiningTable        @relation(fields: [tableId], references: [id])

  @@index([businessId])
  @@index([tableId])
  @@index([status])
  @@index([openedAt])
}

model GuestSession {
  id        String        @id @default(uuid())
  sessionId String
  token     String        @unique @db.Char(64)
  createdAt DateTime      @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  orders    DiningOrder[]
  session   TableSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model DiningOrder {
  id             String        @id @default(uuid())
  businessId     String
  sessionId      String
  tableId        String
  guestSessionId String?
  status         OrderStatus   @default(NEW)
  totalUSD       Decimal       @default(0) @db.Decimal(12, 2)
  totalLBP       Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  session        TableSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  table          DiningTable   @relation(fields: [tableId], references: [id])
  orderLines     OrderLine[]
  submissions    Submission[]

  @@index([businessId])
  @@index([sessionId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
}

model OrderLine {
  id           String      @id @default(uuid())
  orderId      String
  menuItemId   String
  qty          Int
  priceUSD     Decimal     @db.Decimal(10, 2)
  priceLBP     Decimal     @db.Decimal(12, 2)
  rateSnapshot Decimal     @db.Decimal(10, 4)
  createdAt    DateTime    @default(now())
  menuItem     MenuItem    @relation(fields: [menuItemId], references: [id])
  order        DiningOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@index([createdAt])
}

model Submission {
  id             String       @id @default(uuid())
  businessId     String
  idempotencyKey String       @db.VarChar(255)
  payloadHash    String       @db.Char(64)
  orderId        String?
  createdAt      DateTime     @default(now())
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order          DiningOrder? @relation(fields: [orderId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(uuid())
  sessionId    String
  amountUSD    Decimal       @db.Decimal(12, 2)
  amountLBP    Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  recordedById String
  createdAt    DateTime      @default(now())
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  session      TableSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([recordedById])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  KITCHEN
  WAITER
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  EXTERNAL_CARD
}
